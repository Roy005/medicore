# =========================
# MediCore .gitignore
# =========================

# Documentation (internal docs not tracked in repo)
*.docx
*.pdf
docs/internal/
ARCHITECTURE.md
MEMORY.md

# Dependencies
node_modules/
.pnp
.pnp.js

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
*.egg-info/
dist/
build/

# Testing
coverage/
.nyc_output/
htmlcov/
.pytest_cache/

# Build output
.next/
out/
build/
dist/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# Terraform
*.tfstate
*.tfstate.*
.terraform/
*.tfvars
!*.tfvars.example

# Docker
docker-compose.override.yml

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets (NEVER commit secrets)
*.pem
*.key
*.cert
secrets/
