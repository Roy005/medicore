# ============================================
# MediCore AI Service — Environment Variables
# ============================================
# Copy to .env:  cp .env.example .env
# ============================================

# ── Database ─────────────────────────────────
DATABASE_URL=postgresql://medicore:medicore_secret@localhost:5432/medicore

# ── Google Gemini API ─────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Service ──────────────────────────────────
PORT=8001
DEBUG=false
