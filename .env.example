# ============================================
# MediCore — Environment Variables
# ============================================
# Copy this file to .env before running:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control!
# ============================================

# ── PostgreSQL ───────────────────────────────
POSTGRES_DB=medicore
POSTGRES_USER=medicore
POSTGRES_PASSWORD=medicore_secret
POSTGRES_PORT=5433
DATABASE_URL=postgresql://medicore:medicore_secret@127.0.0.1:5433/medicore

# ── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ── Backend (NestJS) ────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=24h
JWT_REFRESH_SECRET=change_me_refresh_secret_in_production
BCRYPT_SALT_ROUNDS=12

# ── AI Service (Python FastAPI) ──────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
AI_SERVICE_PORT=8001

# ── Frontend (Next.js) ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── File Storage (local) ────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
