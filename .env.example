# ============================================
# MediCore — Environment Variables
# ============================================
# Copy this file to .env before running:
#   cp .env.example .env
#
# ⚠️  NEVER commit .env to version control!
# ============================================

# ── PostgreSQL ───────────────────────────────
POSTGRES_DB=medicore
POSTGRES_USER=medicore
POSTGRES_PASSWORD=medicore_secret
POSTGRES_PORT=5432

# ── Redis ────────────────────────────────────
REDIS_PORT=6379

# ── Backend (NestJS) ────────────────────────
JWT_SECRET=change_me_in_production
JWT_EXPIRATION=1h
BCRYPT_SALT_ROUNDS=12

# ── Frontend (Next.js) ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── File Storage (local) ────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
